{
  "name": "react-native-worklet-fs",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "codegenConfig": {
    "name": "WorkletFsSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.workletfs"
    }
  },
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./node": {
      "source": "./src/node.ts",
      "types": "./lib/node.d.ts",
      "default": "./lib/node.js"
    }
  },
  "files": [
    "lib",
    "src",
    "cpp",
    "apple",
    "android/build.gradle",
    "android/src",
    "WorkletFs.podspec",
    "react-native.config.js",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --maxWorkers=2",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "react-native": ">=0.86",
    "react-native-worklets": ">=0.11"
  }
}
